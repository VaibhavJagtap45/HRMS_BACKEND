# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://HRMS:HRMS123@cluster0.9eaas49.mongodb.net/?appName=Cluster0

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed Next.js domain in production
CLIENT_URL=http://localhost:3000


# ── Email / Resend (HTTP API — for Forgot Password) ───────────────────────────
# Resend sends over HTTPS (443), which Render's free tier allows (it blocks SMTP).
# 1. Create an API key:        https://resend.com/api-keys   (looks like "re_...")
# 2. Verify your domain:       https://resend.com/domains    (albostechnologies.com)
# 3. Set RESEND_FROM_EMAIL to an address on that verified domain.
# Leave RESEND_API_KEY blank to get the OTP/reset URL in the API response (dev mode).
RESEND_API_KEY=
# Until the domain is verified, leave this blank to use Resend's test sender
# (onboarding@resend.dev) — it only delivers to the Resend account owner's email.
RESEND_FROM_EMAIL=
EMAIL_FROM=HRMS Albos

