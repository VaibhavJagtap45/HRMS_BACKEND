# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://HRMS:HRMS123@cluster0.9eaas49.mongodb.net/?appName=Cluster0

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed Next.js domain in production
CLIENT_URL=http://localhost:3000


# ── Email — Forgot-Password OTP ───────────────────────────────────────────────
# The mailer (backend/utils/mailer.js) auto-selects a provider:
#   1. RESEND_API_KEY set            -> Resend HTTP API  (use this in PRODUCTION)
#   2. SMTP_HOST/USER/PASS set       -> Gmail SMTP        (great for LOCAL DEV)
#   3. neither                       -> OTP returned in the API response (dev only)
#
# EMAIL_FROM is just the display name here; the address is filled from SMTP_USER
# (SMTP) or RESEND_FROM_EMAIL (Resend), so this value works for both providers.
EMAIL_FROM=HRMS Albos

# ── Local development: Gmail SMTP ─────────────────────────────────────────────
# Works on localhost (SMTP not blocked). SMTP_PASS MUST be a 16-char Gmail
# "App Password", NOT the account login password:
#   https://myaccount.google.com/apppasswords   (needs 2-Step Verification ON)
# If the password below has been revoked, generate a new one and replace it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=albostechnologies016@gmail.com
SMTP_PASS=nyab sgwt qwes lpte

# ── Production (Render): Resend HTTP API ──────────────────────────────────────
# Render's free tier BLOCKS outbound SMTP (25/465/587), so Gmail times out there.
# On the Render dashboard set RESEND_API_KEY + RESEND_FROM_EMAIL instead (they
# override the SMTP vars above because Resend takes priority).
#   1. API key:        https://resend.com/api-keys   ("re_...")
#   2. Verify domain:  https://resend.com/domains     (albostechnologies.com)
#   3. RESEND_FROM_EMAIL = an address on that verified domain (e.g. noreply@albostechnologies.com)
# Left blank locally so dev uses Gmail SMTP above.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Keep-alive (prevents Render free-tier cold starts) ────────────────────────
# The backend self-pings its own /api/health on an interval so Render never
# spins it down. On Render, RENDER_EXTERNAL_URL is injected automatically, so no
# config is needed there. These are optional overrides:
#   KEEPALIVE_ENABLED=true|false   (default: on only when NODE_ENV=production)
#   KEEPALIVE_URL=https://hrms-backend-t3lj.onrender.com/api/health
#   KEEPALIVE_MINUTES=10           (1..14; must stay under Render's ~15-min idle)
# Disabled in local dev by default. To smoke-test it locally:
#   KEEPALIVE_ENABLED=true
#   KEEPALIVE_URL=http://localhost:5000/api/health
